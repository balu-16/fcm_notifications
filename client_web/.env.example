# Same-origin API prefix. Set an HTTPS API URL here only when hosted separately.
VITE_API_URL=/api
# Optional Vite-only upstream; useful when the API is not on this machine.
# DEV_API_PROXY_TARGET=http://127.0.0.1:3000
# AWS region containing the Cognito user pool.
VITE_COGNITO_REGION=
# Cognito user pool shared by the web and Android apps.
VITE_COGNITO_USER_POOL_ID=
# Public Cognito app client ID for the web app.
VITE_COGNITO_CLIENT_ID=
# Public Firebase web app API key.
VITE_FIREBASE_API_KEY=
# Firebase web app authentication domain.
VITE_FIREBASE_AUTH_DOMAIN=
# Firebase project used for web and Android messaging.
VITE_FIREBASE_PROJECT_ID=
# Firebase storage bucket from the web app configuration.
VITE_FIREBASE_STORAGE_BUCKET=
# Firebase Cloud Messaging sender ID.
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Firebase web application ID.
VITE_FIREBASE_APP_ID=
# Public Web Push VAPID key used to register the browser.
VITE_FIREBASE_VAPID_KEY=
# Optional Firebase Analytics measurement ID; this project does not enable Analytics.
VITE_FIREBASE_MEASUREMENT_ID=
