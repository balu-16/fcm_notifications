# Server runtime environment, which controls local-only URL allowances.
NODE_ENV=development
# Port on which the API listens.
PORT=3000
# PostgreSQL connection URL matching the root Docker credentials.
DATABASE_URL=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AWS region containing the Cognito user pool.
COGNITO_REGION=
# Cognito user pool that issues client ID tokens.
COGNITO_USER_POOL_ID=
# Comma-separated Cognito app client IDs permitted to call the API.
COGNITO_APP_CLIENT_IDS=
# Exact, case-sensitive Cognito group name that grants administrator access.
COGNITO_ADMIN_GROUP=ADMIN
# Private Firebase Admin service-account JSON path relative to the server directory.
FIREBASE_SERVICE_ACCOUNT_PATH=./.secrets/firebase-service-account.json
