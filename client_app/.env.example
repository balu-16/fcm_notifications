# API URL reachable from the Android device, using the computer LAN IP or HTTPS tunnel.
EXPO_PUBLIC_API_URL=
# AWS region containing the Cognito user pool.
EXPO_PUBLIC_COGNITO_REGION=
# Cognito user pool shared by the web and Android apps.
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
# Public Cognito app client ID for the Android app.
EXPO_PUBLIC_COGNITO_CLIENT_ID=
# Android application ID registered in Firebase.
ANDROID_PACKAGE_NAME=
# Optional EAS file variable containing the path to google-services.json on the build worker.
GOOGLE_SERVICES_JSON=
# EAS project ID populated after the project is initialized.
EAS_PROJECT_ID=
